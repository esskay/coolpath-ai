# ==========================================
# CoolPath AI - Environment Configuration
# ==========================================

# FortyGuard Microclimate API
# Sign up at: https://portal.fortyguard.com (or leave blank to use built-in 2m simulation mock)
FORTYGUARD_API_KEY=
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com/v1
FORTYGUARD_TIMEOUT_SECONDS=10.0

# Uber H3 Grid Configuration
# Res 9: ~100m edge, Res 10: ~40m edge (optimal for urban canyons)
DEFAULT_H3_RESOLUTION=9

# Thermal Routing Tuning Defaults
DEFAULT_ALPHA=1.8
DEFAULT_TEMP_THRESHOLD=33.0

# Server Port
PORT=8000
HOST=0.0.0.0
DEBUG=true
